# Databento API Key (required for live data)
DATABENTO_API_KEY=your_databento_api_key_here

# Redis
REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=postgresql+asyncpg://axiom:axiom@localhost:5432/axiom

# Risk Parameters
MAX_DRAWDOWN_LIMIT=0.15
MAX_POSITION_SIZE=0.25
MAX_LEVERAGE=2.0
AUTO_HALT_ENABLED=true

# Logging
LOG_LEVEL=INFO
